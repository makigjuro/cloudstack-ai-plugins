{
  "$schema": "https://raw.githubusercontent.com/makigjuro/cloud-app-blueprint/main/schema/blueprint.schema.json",
  "project": {
    "name": "MyProject",
    "namespace": "MyProject",
    "description": "A brief description of your project"
  },
  "backend": {
    "solutionPath": "src/MyProject.sln",
    "sharedDomainPath": "src/Shared/MyProject.Domain",
    "sharedInfraPath": "src/Shared/MyProject.Shared.Infrastructure",
    "sharedPaths": [
      "src/Shared/MyProject.Domain",
      "src/Shared/MyProject.Shared.Infrastructure"
    ],
    "services": [
      {
        "name": "ServiceOne",
        "path": "src/ServiceOne",
        "projectPrefix": "MyProject.ServiceOne",
        "dbContext": "ServiceOneDbContext",
        "aliases": ["s1", "service-one"],
        "labels": ["service-one"],
        "testProjects": {
          "unit": ["tests/MyProject.ServiceOne.Tests"],
          "integration": ["tests/MyProject.ServiceOne.Tests.Integration"]
        }
      }
    ]
  },
  "frontend": {
    "path": "web",
    "devPort": 5173,
    "smokeRoutes": ["/", "/dashboard"]
  },
  "infrastructure": {
    "runtime": "container-apps",
    "frontendHosting": "static-web-app",
    "terraformPath": "infra/terraform/modules",
    "iacWrapper": "terragrunt",
    "terragruntPath": "infra/terragrunt",
    "containerApps": {
      "appUnitsPath": "infra/terragrunt/{env}",
      "gatewayApp": "gateway",
      "migrationJobs": { "ServiceOne": "service-one-migrate" },
      "environments": ["dev", "staging", "prod"]
    },
    "chartsPath": "deploy/charts"
  },
  "localDev": {
    "authConfig": {
      "storageKey": "auth-storage",
      "state": { "isAuthenticated": true, "token": "dev-token" },
      "formFields": { "apiKey": "dev-api-key" }
    }
  }
}
